claim s91: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/roles/2/label :: проверяющий"; time=future; number=one.
claim s92: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/roles/2/scope :: сопоставляет источники, последствия и смысловые потери"; time=future; number=one.
claim s93: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/roles/3/label :: ответственный человек"; time=future; number=one.
claim s94: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/roles/3/scope :: отдельно принимает решение в своей подтверждённой области; локальная метка роли полномочий не создаёт"; time=future; number=one.
claim s95: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/workflow/0/title :: вопрос"; time=future; number=one.
