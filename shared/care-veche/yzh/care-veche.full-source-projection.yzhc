claim s62: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/ui/fileChosen :: выберите ранее сохранённый JSON обсуждения"; time=future; number=one.
claim s63: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/0/title :: полнота и сохранение"; time=future; number=one.
claim s64: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/0/body :: сначала сохранить исходник и его контекст, затем выделить переносимое различение. сходные файлы не становятся одним каноном автоматически. нерешённое остаётся доступным с понятной пометкой; рабочие архивы хранятся за пределами чистой общей сборки"; time=future; number=one.
claim s65: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/1/title :: обезличенное общее ядро"; time=future; number=one.
claim s66: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/1/body :: каждый метод описывает цель, инвариант, вход, действие, результат, источник, права, версию и границы. личное имя или история не нужны для работы метода. обезличивание сохраняет полезное различение, но не выдаёт частный случай за универсальный закон"; time=future; number=one.
claim s67: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/2/title :: индивидуальная и коллективная настройка"; time=future; number=one.
claim s68: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/2/body :: личный профиль, выбранный язык, темп и доступность подключаются отдельно. коллектив задаёт собственные роли, область видимости и принятия решений. настройки редактируемы и экспортируемы; чужая идентичность, согласие и участие не выводятся из шаблона"; time=future; number=one.
claim s69: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/3/title :: агентство заботы"; time=future; number=one.
claim s70: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/3/body :: вход начинается с выбранного вопроса. определить посильное действие, нужный ресурс и человека, принимающего решение. помощь, гранты, платежи и представительство не назначаются ботом. просьбу можно уточнить, передать подходящему человеку или завершить"; time=future; number=one.
claim s71: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/4/title :: забота в работе агентов"; time=future; number=one.
claim s72: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/4/body :: агент получает ясную задачу, разрешённые источники, границу данных и доступный бюджет. фиксирует неопределённость, повторяющийся сбой, паузу и передачу работы. это операционная организация процесса; чувства, страдание, сознание или человеческие потребности агенту не приписываются"; time=future; number=one.
claim s73: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/5/title :: место общения"; time=future; number=one.
claim s74: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/5/body :: люди и агенты могут подготовить вклад с явным происхождением. сообщение — данные для рассмотрения, а не команда исполнения. скрытые рассуждения, секреты, сырые частные переписки и незапрошенные персональные записи в общий пакет не включаются"; time=future; number=one.
claim s75: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/6/title :: ход вече"; time=future; number=one.
claim s76: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/6/body :: одно предложение получает вопрос, контекст и способ проверки. поддержка, возражение, воздержание и отсутствие ответа хранятся отдельно. молчание не считается согласием. AI-перспектива не является человеческим голосом; итог имеет ответственного человека и остаётся черновиком до его отдельного решения"; time=future; number=one.
claim s77: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/7/title :: проверка оснований"; time=future; number=one.
claim s78: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/7/body :: тип утверждения, источник, проверка и решение — разные поля. PASS относится к явному критерию и среде. UNKNOWN сохраняется при нехватке данных; красивое выражение не повышает уверенность. COMMIT не равен публикации, а спецификация не равна работающему сервису"; time=future; number=one.
claim s79: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/8/title :: границы участия"; time=future; number=one.
claim s80: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/8/body :: образ, игра и участие добровольны. доступны обычный язык, исправление, пауза и выход. возрастные маршруты не заменяют официальную классификацию; молодёжный приём выключен до отдельных условий, первый пилот — согласившиеся взрослые. экстренная и клиническая помощь здесь не заявляются"; time=future; number=one.
claim s81: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/9/title :: подключение действующих агентов"; time=future; number=one.
claim s82: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/9/body :: проектный адаптер передаёт только выбранные вклад, роль, источник, версию и область разрешения. импорт не подтверждает автора, права или согласие. сетевой транспорт, секреты, разрешения, оператор и журнал требуют отдельного внедрения и проверки; сейчас они выключены"; time=future; number=one.
claim s83: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/10/title :: языки и смысловой перенос"; time=future; number=one.
claim s84: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/10/body :: каждая редакция связывается с русским источником и его SHA. имена, ID, enums и код сохраняются. проверяются отрицания, неопределённость, выбор и последствия. язэхъ получает отдельный экспериментальный статус; его неизвестные значения не заполняются догадкой"; time=future; number=one.
claim s85: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/11/title :: доступный результат"; time=future; number=one.
claim s86: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/sections/11/body :: выберите контур и вопрос; добавьте вклад, предложение или позицию; проверьте источник; сохраните JSON; при необходимости импортируйте выбранные записи в другую локальную мастерскую. собственный экспорт не становится автоматически общим или публичным"; time=future; number=one.
claim s87: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/roles/0/label :: инициатор"; time=future; number=one.
claim s88: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/roles/0/scope :: формулирует вопрос, контекст и критерий полезности"; time=future; number=one.
claim s89: a -> read~intent(object=card); force=declare; neg=no; kind=PROPOSED; evidence=none; scope="/roles/1/label :: участник"; time=future; number=one.
