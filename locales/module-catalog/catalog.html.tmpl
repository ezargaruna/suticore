<!doctype html>
<!-- Generated by scripts/build_module_catalog.py -->
<html lang="ru" dir="ltr" data-theme="day">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta id="description" name="description" content="$description">
  <title>$title · SUTI.world</title>
  <link rel="stylesheet" href="https://ezargaruna.github.io/suticore/assets/css/suti-angels-editorial.css">
  <style>
    @font-face { font-family: Catalog Arabic; src: url("https://ezargaruna.github.io/suticore/assets/fonts/notosansarabic/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Catalog Devanagari; src: url("https://ezargaruna.github.io/suticore/assets/fonts/notosansdevanagari/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Catalog Bengali; src: url("https://ezargaruna.github.io/suticore/assets/fonts/notosansbengali/regular.ttf") format("truetype"); font-display: swap; }
    :root { background: #f4f0e8; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #f4f0e8; color: #25342f; font: 1rem/1.65 "SUTI Manrope", system-ui, sans-serif; }
    :is(h1,h2,h3) { font-family: "SUTI Nunito", system-ui, sans-serif; }
    html[lang="ar"] :is(body,h1,h2,h3) { font-family: Catalog Arabic, system-ui, sans-serif; }
    html:is([lang="hi"],[lang="sa"]) :is(body,h1,h2,h3) { font-family: Catalog Devanagari, system-ui, sans-serif; }
    html[lang="bn"] :is(body,h1,h2,h3) { font-family: Catalog Bengali, system-ui, sans-serif; }
    main { width: min(100% - 2rem,72rem); margin-inline: auto; padding-block: 1.25rem 3rem; overflow-wrap: anywhere; }
    a { color: #365958; text-underline-offset: .2em; }
    :is(a,input,select):focus-visible { outline: 3px solid #365958; outline-offset: 3px; }
    .skip { position: absolute; inset-inline-start: -10000px; }
    .skip:focus { inset-inline-start: 1rem; inset-block-start: 1rem; background: #fcf8f2; padding: .5rem; z-index: 2; }
    nav { display: flex; flex-wrap: wrap; gap: .5rem 1.1rem; }
    header, section { padding: clamp(1rem,3vw,2rem); margin-block: 1rem; background: #fffdf8; border: 1px solid #d8d0c1; border-radius: 16px; }
    h1 { font-size: clamp(2rem,6vw,3.7rem); line-height: 1.12; margin-block: .3em; }
    h3 { font-size: 1.1rem; margin-block: 0 .45rem; }
    .notice { padding: .7rem .9rem; background: #eaf5f2; border-inline-start: 4px solid #57b8b0; }
    .tools, footer { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; align-items: end; }
    .tools label { display: grid; gap: .2rem; min-inline-size: 0; max-inline-size: 100%; }
    .tools :is(input,select) { inline-size: 100%; max-inline-size: 100%; min-inline-size: 0; font: inherit; padding: .45rem; border: 1px solid #687064; border-radius: 7px; background: #fff; color: inherit; }
    .catalog { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,18rem),1fr)); gap: .75rem; }
    .module { padding: .9rem; border: 1px solid #d8d0c1; border-radius: 12px; display: flex; flex-direction: column; gap: .4rem; }
    .module code { font-size: .8rem; unicode-bidi: isolate; }
    .module p { margin: 0; }
    .source-meta { color: #465a51; }
    [hidden] { display: none !important; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto !important; } }
  </style>
</head>
<body>
  <a class="skip" href="#main" data-copy="skip">$skip</a>
  <main id="main" tabindex="-1">
    <nav aria-label="$nav">
      <a id="catalog-home" href="https://suti.world/?lang=ru#library">SUTI.world</a>
      <a href="https://ezargaruna.github.io/suticore/nitya.html" hreflang="ru">NITYA · RU</a>
      <a href="https://github.com/ezargaruna/suticore">GitHub</a>
      <a href="https://ezargaruna.github.io/suticore/modules/index.html" hreflang="ru" data-copy="moduleMap">$moduleMap</a>
    </nav>
    <header>
      <p data-copy="introLabel">$introLabel</p>
      <h1 data-copy="page-title">$title</h1>
      <p data-copy="page-intro">$description</p>
      <p class="notice" data-copy="page-caveat">$caveat</p>
      <p class="notice" data-copy="review">$review</p>
      <div class="tools" id="catalog-tools" hidden>
        <label><span data-copy="language-label">$languageLabel</span><select id="locale">$options</select></label>
        <label><span data-copy="filterLabel">$filterLabel</span><input id="filter" type="search" autocomplete="off"></label>
      </div>
      <p id="count" role="status" aria-live="polite">$count</p>
    </header>
    <p id="empty" data-copy="empty" hidden>$empty</p>
$sections
    <footer>
      <p data-copy="rights-note">$rights</p>
      <a id="catalog-return" href="https://suti.world/?lang=ru#library" data-copy="returnLabel">$returnLabel</a>
      <a href="https://ezargaruna.github.io/suticore/locales/module-catalog/coverage.json" data-copy="register">$register</a>
    </footer>
  </main>
  <script type="application/json" id="catalog-languages">$localeData</script>
  <script>
$runtime
  </script>
</body>
</html>
