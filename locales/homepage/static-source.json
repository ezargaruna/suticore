    "kind": "text"
  },
  "s05": {
    "source": "анкета заботы",
    "kind": "text"
  },
  "s06": {
    "source": "попросить",
    "kind": "text"
  },
  "s07": {
    "source": "разобраться",
    "kind": "text"
  },
  "s08": {
    "source": "нейровече",
    "kind": "text"
  },
  "s09": {
    "source": "подумать вместе",
    "kind": "text"
  },
  "s10": {
