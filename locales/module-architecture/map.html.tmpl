<!doctype html>
<!-- Generated by scripts/build_module_architecture.py -->
<html lang="$language" dir="$direction" data-theme="day">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="$description">
  <title>$title</title>
  <link rel="canonical" href="$canonical">
$alternates
  <link rel="stylesheet" href="$assets/css/suti-angels-editorial.css">
  <style>
    @font-face { font-family: Map Arabic; src: url("$assets/fonts/notosansarabic/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Map Devanagari; src: url("$assets/fonts/notosansdevanagari/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Map Bengali; src: url("$assets/fonts/notosansbengali/regular.ttf") format("truetype"); font-display: swap; }
    :root { background: #f4f0e8; color: #25342f; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 1rem/1.65 "SUTI Manrope", system-ui, sans-serif; }
    h1, h2, h3 { font-family: "SUTI Nunito", system-ui, sans-serif; line-height: 1.25; }
    html[lang="ar"] :is(body,h1,h2,h3) { font-family: Map Arabic, system-ui, sans-serif; }
    html:is([lang="hi"],[lang="sa"]) :is(body,h1,h2,h3) { font-family: Map Devanagari, system-ui, sans-serif; }
    html[lang="bn"] :is(body,h1,h2,h3) { font-family: Map Bengali, system-ui, sans-serif; }
    a { color: #365958; text-underline-offset: .2em; }
    :is(a,summary):focus-visible { outline: 3px solid #365958; outline-offset: 3px; }
    .wrap { width: min(100% - 2rem, 70rem); margin-inline: auto; overflow-wrap: anywhere; }
    .skip { position: absolute; inset-inline-start: -10000px; }
    .skip:focus { inset-inline-start: 1rem; inset-block-start: 1rem; background: #fcf8f2; padding: .5rem; z-index: 2; }
    header, footer { padding-block: 1rem; }
    nav, .language-list { display: flex; flex-wrap: wrap; gap: .45rem 1rem; }
    details { margin-block-start: .7rem; }
    summary { cursor: pointer; }
    .language-list { padding: 0; list-style: none; }
    [aria-current="page"] { font-weight: 700; }
    .hero { padding-block: clamp(1.6rem,6vw,3.2rem); }
    h1 { font-size: clamp(2rem,6vw,4rem); margin-block: .4em; }
    .lead, .note { max-width: 75ch; }
    .note { padding: .8rem 1rem; background: #fcf8f2; border-inline-start: 4px solid #57b8b0; }
    .section { padding-block: 1.5rem; border-block-start: 1px solid #d8d0c1; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,17rem),1fr)); gap: .85rem; }
    .card { padding: 1rem; border: 1px solid #d8d0c1; border-radius: 12px; background: #fcf8f2; min-inline-size: 0; }
    .card h3, .card p { margin-block: 0 .5rem; }
    .type { color: #365958; }
    .resource-list { padding-inline-start: 1.25rem; }
    .resource-list li { margin-block: .3rem; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto !important; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">$skip</a>
  <header class="wrap">
    <nav><a href="$homeLink">SUTI.world</a><a href="$catalogLink">$catalog</a></nav>
    <details>
      <summary>$languages</summary>
      <ul class="language-list" role="list">
$languageLinks
      </ul>
    </details>
  </header>
  <main class="wrap" id="main" tabindex="-1">
    <section class="hero">
      <p>$review</p>
      <h1>$h1</h1>
      <p class="lead">$lead</p>
      <p>$status</p>
      <div class="note"><strong>$scopeTitle</strong><p>$scope</p></div>
      <h2>$resourcesTitle</h2>
      <ul class="resource-list">$resources</ul>
    </section>
$sections
  </main>
  <footer class="wrap"><p>Ezar Garuna · SUTI.world · 2026.11-r5</p><a href="$homeLink">$home</a></footer>
</body>
</html>
