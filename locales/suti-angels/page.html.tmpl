<!doctype html>
<!-- Generated by scripts/build_suti_angels_editions.py -->
<html lang="$lang" dir="$direction" data-theme="day">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="$description">
  <meta name="theme-color" content="#F4F0E8">
  <title>$title</title>
  <link rel="canonical" href="$canonical">
$alternates
  <link rel="stylesheet" href="$stylesheet">
  <style>
    @font-face { font-family: Angels Arabic; src: url("${assets}notosansarabic/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Angels Devanagari; src: url("${assets}notosansdevanagari/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Angels Bengali; src: url("${assets}notosansbengali/regular.ttf") format("truetype"); font-display: swap; }
    :root { color-scheme: light; background: #f4f0e8; color: #25342f; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #f4f0e8; color: #25342f; font: 1rem/1.65 "SUTI Manrope", system-ui, sans-serif; }
    html[lang="ar"] body, html[lang="ar"] h1, html[lang="ar"] h2 { font-family: Angels Arabic, system-ui, sans-serif; }
    html:is([lang="hi"],[lang="sa"]) body, html:is([lang="hi"],[lang="sa"]) h1, html:is([lang="hi"],[lang="sa"]) h2 { font-family: Angels Devanagari, system-ui, sans-serif; }
    html[lang="bn"] body, html[lang="bn"] h1, html[lang="bn"] h2 { font-family: Angels Bengali, system-ui, sans-serif; }
    a { color: #365958; text-underline-offset: .18em; }
    :is(a, summary):focus-visible { outline: 3px solid #365958; outline-offset: 4px; }
    .wrap { width: min(100% - 2rem, 70rem); margin-inline: auto; }
    .skip { position: absolute; inset-inline-start: -10000px; }
    .skip:focus { inset-inline-start: 1rem; inset-block-start: 1rem; padding: .6rem; background: #fcf8f2; z-index: 2; }
    .angels-header, .angels-footer { padding-block: 1rem; border-block-end: 1px solid #d8d0c1; }
    .angels-header .wrap { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; align-items: baseline; }
    .angels-header details { flex-basis: 100%; }
    summary { cursor: pointer; }
    .languages { display: flex; flex-wrap: wrap; gap: .5rem 1rem; padding-inline-start: 0; list-style: none; }
    .languages a { display: inline-block; padding: .2rem .25rem; }
    .languages a[aria-current="page"] { font-weight: 700; text-decoration-thickness: .15em; }
    .hero { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); align-items: center; gap: clamp(1.5rem,5vw,4rem); padding-block: clamp(2rem,7vw,5rem); }
    h1, h2 { font-family: "SUTI Nunito", system-ui, sans-serif; line-height: 1.22; overflow-wrap: anywhere; }
    h1 { color: #365958; font-size: clamp(2rem,5vw,3.5rem); }
    .lead { font-size: 1.15rem; }
    .notice, .fine, figcaption { color: #52615a; font-size: .94rem; }
    .actions { display: flex; flex-wrap: wrap; gap: .65rem 1.2rem; align-items: center; }
    .primary { display: inline-block; padding: .65rem 1rem; border-radius: 12px; background: #365958; color: #fff; font-weight: 700; }
    .poster { margin: 0; }
    .poster img { display: block; width: 100%; height: auto; border: 1px solid #d8d0c1; border-radius: 16px; }
    figcaption { margin-block-start: .5rem; }
    .section { padding-block: 1.5rem; border-block-start: 1px solid #d8d0c1; }
    .cycle { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,8rem),1fr)); gap: .6rem; padding-inline-start: 0; list-style: none; }
    .cycle li, .note { padding: .8rem 1rem; background: #fcf8f2; border: 1px solid #d8d0c1; border-radius: 12px; }
    .note { border-inline-start: 3px solid #b98c49; }
    .angels-footer { border-block-start: 1px solid #d8d0c1; border-block-end: 0; }
    @media (max-width: 760px) { .hero { grid-template-columns: minmax(0,1fr); } .poster { max-width: 28rem; } }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto !important; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">$skip</a>
  <header class="angels-header">
    <div class="wrap">
      <a href="index.html">SUTI.world</a>
      <a href="$libraryUrl">$library</a>
      <details>
        <summary>$languages</summary>
        <ul class="languages">
$languageLinks
        </ul>
      </details>
    </div>
  </header>
  <main id="main" class="wrap" tabindex="-1">
    <section class="hero" aria-labelledby="page-title">
      <div>
        <p class="notice">$notice</p>
        <h1 id="page-title">$h1</h1>
        <p class="lead">$lead</p>
        <p>$optional</p>
        <p id="form-notice" class="fine">$formNotice</p>
        <div class="actions">
          <a class="primary" href="$formUrl" target="_blank" rel="noopener noreferrer" aria-describedby="form-notice">$form <span aria-hidden="true">↗</span></a>
          <a href="$channelUrl" target="_blank" rel="noopener noreferrer">$channel <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="poster">
        <img src="$poster" width="1254" height="1254" alt="$posterAlt">
        <figcaption>$posterCaption</figcaption>
      </figure>
    </section>
    <section class="section" aria-labelledby="cycle-title">
      <h2 id="cycle-title">$cycleTitle</h2>
      <ol class="cycle" role="list">$steps</ol>
      <p>$practice</p>
      <p>$distinguish</p>
    </section>
    <section class="section" aria-labelledby="meaning-title">
      <h2 id="meaning-title">$meaningTitle</h2>
      <p>$meaning</p>
      <div class="note"><p>$privacy</p><p>$help</p></div>
    </section>
  </main>
  <footer class="wrap angels-footer"><a href="$libraryUrl">$back</a></footer>
</body>
</html>
