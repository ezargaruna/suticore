<!doctype html>
<!-- Generated by scripts/build_synaura_guide.py -->
<html lang="$lang" dir="$direction" data-theme="day">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$title</title>
  <link rel="canonical" href="$canonical">
$alternates
  <link rel="stylesheet" href="https://ezargaruna.github.io/suticore/assets/css/suti-angels-editorial.css">
  <style>
    @font-face { font-family: Guide Arabic; src: url("https://ezargaruna.github.io/suticore/assets/fonts/notosansarabic/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Guide Devanagari; src: url("https://ezargaruna.github.io/suticore/assets/fonts/notosansdevanagari/regular.woff2") format("woff2"); font-display: swap; }
    @font-face { font-family: Guide Bengali; src: url("https://ezargaruna.github.io/suticore/assets/fonts/notosansbengali/regular.ttf") format("truetype"); font-display: swap; }
    :root { background: #f4f0e8; }
    * { box-sizing: border-box; }
    body { margin: 0; color: #25342f; background: #f4f0e8; font: 1rem/1.65 "SUTI Manrope", system-ui, sans-serif; }
    h1, h2, h3 { font-family: "SUTI Nunito", system-ui, sans-serif; }
    html[lang="ar"] :is(body, h1, h2, h3) { font-family: Guide Arabic, system-ui, sans-serif; }
    html:is([lang="hi"], [lang="sa"]) :is(body, h1, h2, h3) { font-family: Guide Devanagari, system-ui, sans-serif; }
    html[lang="bn"] :is(body, h1, h2, h3) { font-family: Guide Bengali, system-ui, sans-serif; }
    a { color: #365958; text-underline-offset: .18em; }
    :is(a, summary):focus-visible { outline: 3px solid #365958; outline-offset: 4px; }
    .wrap { width: min(100% - 2rem, 74ch); margin-inline: auto; }
    .skip { position: absolute; inset-inline-start: -10000px; }
    .skip:focus { inset-inline-start: 1rem; inset-block-start: 1rem; padding: .55rem; background: #fcf8f2; z-index: 2; }
    header, footer { padding-block: 1rem; border-block-end: 1px solid #d8d0c1; }
    header details { margin-block-start: .8rem; }
    summary { cursor: pointer; }
    .languages { display: flex; flex-wrap: wrap; gap: .5rem 1rem; padding: 0; list-style: none; }
    .languages a { display: inline-block; padding: .15rem .25rem; }
    [aria-current="page"] { font-weight: 700; }
    main { padding-block: 1.4rem 2.5rem; overflow-wrap: anywhere; }
    h2 { margin-block-start: 2rem; }
    article blockquote { margin-inline: 0; padding: .85rem 1rem; border-inline-start: 3px solid #a97c43; background: #fcf8f2; }
    code { unicode-bidi: isolate; }
    footer { border-block-start: 1px solid #d8d0c1; border-block-end: 0; }
    .resources { display: flex; flex-wrap: wrap; gap: .65rem 1.25rem; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto !important; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">$skip</a>
  <header><div class="wrap">
    <a href="$home">SUTI.world</a>
    <details>
      <summary>$languages</summary>
      <ul class="languages" role="list">
$language_links
      </ul>
    </details>
  </div></header>
  <main id="main" class="wrap" tabindex="-1">
    <article>
$body
    </article>
  </main>
  <footer><div class="wrap">
    <p>Ezar Garuna · .synaura · 1.0.0</p>
    <div class="resources">
      <a href="$home">$back</a>
      <a href="$markdown" download>$markdown_label</a>
      <a href="../README.md" hreflang="ru">$source_label</a>
      <a href="../LICENSE">MIT</a>
    </div>
  </div></footer>
</body>
</html>
